{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2021",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": false,
    "strictBindCallApply": false,
    "noFallthroughCasesInSwitch": false,
    "paths": {
      "@app/db-config": [
        "libs/db-config/src"
      ],
      "@app/db-config/*": [
        "libs/db-config/src/*"
      ],
      "@app/kafka-config": [
        "libs/kafka-config/src"
      ],
      "@app/kafka-config/*": [
        "libs/kafka-config/src/*"
      ],
      "@app/libs": [
        "libs/libs/src"
      ],
      "@app/libs/*": [
        "libs/libs/src/*"
      ]
    }
  }
}